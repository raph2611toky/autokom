#!/bin/bash
# AUTOKOM infrastructure-validation endpoint: NOT a production application.
set -euo pipefail
install -m 0755 -d /usr/local/lib/autokom-ha
cat >/usr/local/lib/autokom-ha/validation_server.py <<'PYAPP'
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import socket

PORT = ${backend_port}
HEALTH = ${jsonencode(health_check_path)}

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.split("?", 1)[0] not in ("/", HEALTH):
            self.send_error(404, "Not Found")
            return
        message = ("AUTOKOM HA - infrastructure validation only (no application deployed)\n"
                   "instance=" + socket.gethostname() + "\n")
        body = message.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass

ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
PYAPP
chmod 0644 /usr/local/lib/autokom-ha/validation_server.py
cat >/etc/systemd/system/autokom-ha-validation.service <<'UNIT'
[Unit]
Description=AUTOKOM HA infrastructure validation endpoint - NOT production
After=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/bin/python3 /usr/local/lib/autokom-ha/validation_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now autokom-ha-validation.service
