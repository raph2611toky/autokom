# Copier ce fichier en terraform.tfvars (non versionne).
# Parametres du projet GCP confirme dans nos anciens diagnostics.
project_id      = "plucky-stacker-480421-c4"
region          = "us-central1"
zones           = ["us-central1-a", "us-central1-f"]
network_name    = "default"          # Verifier le vrai reseau et le sous-reseau
subnetwork_name = "default"
name_prefix     = "autokom-ha"

# Les instances du MIG sont NOUVELLES ; ubuntu-server-2 et le serveur principal restent intacts : ni l'orchestrateur ni les serveurs existants ne sont modifies.
machine_type       = "e2-custom-2-4096"
boot_disk_size_gb   = 100
assign_external_ip = false
# Sortie internet : necessaire si bootstrap Ubuntu installe des paquets externes.
# Cloud NAT couvre le sous-reseau entier, pas seulement les instances MIG.
enable_cloud_nat  = false
min_replicas       = 2
max_replicas       = 6
cpu_target         = 0.55
cooldown_seconds   = 90
backend_port       = 8080
health_check_path  = "/healthz"
# Les paquets Docker ont pris >10 min sur les VM GCP initiales. Pas d'effet
# sur le mode validation (360 s); utile pour les workers et applications.
worker_initial_delay_seconds = 1800

# validation : serveur de validation (actuel).
# worker : installe Docker et teste l'acces Artifact Registry, SANS applications clientes.
# application : demarrage applicatif specifique (requiert script explicite).
# Ne changer le mode qu'apres avoir verifie le plan Terraform et prepare un retour arriere.
artifact_repository = "autokom-ha-images"
bootstrap_mode                 = "validation"
application_startup_script_file = ""

# Phase initiale : HTTP pour test de reseau. Activer HTTPS apres creation DNS vers IP du LB.
enable_https = false
domain_name  = null

# ATTENTION : 2+ machines + Load Balancer + IP globale generent des couts.
# Conserver false jusqu'a revue du plan, quota, facturation et regles firewall.
restrict_mig_ingress        = true
confirm_billable_resources = false

# Activer seulement apres avoir confirme les droits GCS/les couts du stockage.
enable_app_delivery = false
