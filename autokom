#!/usr/bin/env bash
# AUTOKOM CLI: un point d'entrée simple, sans dépendance Python externe.
set -Eeuo pipefail
SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT")" && pwd -P)"
if [[ "$ROOT" == /opt/autokom-preprod/source && "${1:-}" != update ]]; then
    echo 'Préproduction : utiliser scripts/preprod/manage.sh. Seule la commande update est disponible ici.' >&2
    exit 2
fi
exec python3 "$ROOT/scripts/lib/autokom_cli.py" "$@"
