# MySQL exclusivement, y compris en développement et pour les tests.
DEBUG=True
DJANGO_SECRET_KEY=CHANGE_ME_WITH_GENERATED_RANDOM_SECRET
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=mysql
DB_NAME=autokom_platform
DB_USER=autokom
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_autokom_platform

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

CLIENT_JWT_SIGNING_KEY=CHANGE_ME_WITH_LONG_INDEPENDENT_SECRET
CLIENT_JWT_ISSUER=autokom-platform
CLIENT_JWT_AUDIENCE=autokom-clients
CLIENT_ACCESS_MINUTES=15
CLIENT_REFRESH_DAYS=7

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AUTOKOM <no-reply@example.invalid>
# Production : SMTP et HTTPS obligatoire, avec reverse proxy fiable.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.invalid
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL_HEADER=False

# GitHub App : une application distincte du compte GitHub de l'utilisateur
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Doit correspondre EXACTEMENT au callback configuré dans GitHub App
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:8000/api/projects/git/github/callback/
GITHUB_WEBHOOK_SECRET=
# Générer avec python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOKOM_FIELD_ENCRYPTION_KEY=
AUTOKOM_BASE_DOMAIN=apps.autokom.example
GITHUB_API_VERSION=2026-03-10
