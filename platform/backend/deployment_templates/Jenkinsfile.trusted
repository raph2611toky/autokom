// AUTOKOM PLATFORM - TRUSTED pipeline (store in Jenkins controller job configuration).
// NEVER load Jenkinsfile from a client repository. Run only on isolated agents.
// Credentials: autokom-runner-key (secret text) and autokom-github-app (GitHub App).
// Agent env: AUTOKOM_API_BASE (HTTPS backend), AUTOKOM_IMAGE_REGISTRY (private registry).
pipeline {
    agent { label 'autokom-isolated' }
    options {
        timestamps()
        skipDefaultCheckout(true)
        timeout(time: 40, unit: 'MINUTES')
    }
    parameters {
        string(name: 'AUTOKOM_RUN_ID', defaultValue: '', description: 'UUID du déploiement AUTOKOM')
    }
    stages {
        stage('Source GitHub') {
            steps {
                script {
                    echo 'AUTOKOM_STAGE:source:RUNNING'
                    withCredentials([string(credentialsId: 'autokom-runner-key', variable: 'AUTOKOM_RUNNER_SHARED_KEY')]) {
                        def raw = sh(script: 'set +x; python3 /opt/autokom-runner/autokom_agent.py metadata', returnStdout: true).trim()
                        def meta = new groovy.json.JsonSlurperClassic().parseText(raw)
                        if (!(meta.clone_url ==~ /^https:\/\/github\.com\/[a-zA-Z0-9_.-]+\/[a-zA-Z0-9_.-]+\.git$/)
                                || !(meta.commit_sha ==~ /^[a-f0-9]{40}$/)) {
                            error 'Dépôt GitHub ou SHA du manifest invalide.'
                        }
                        checkout([$class: 'GitSCM', branches: [[name: meta.commit_sha]],
                            doGenerateSubmoduleConfigurations: false,
                            userRemoteConfigs: [[url: meta.clone_url, credentialsId: 'autokom-github-app']]])
                    }
                    echo 'AUTOKOM_STAGE:source:SUCCESS'
                }
            }
        }
        stage('SAST Semgrep') {
            steps {
                withCredentials([string(credentialsId: 'autokom-runner-key', variable: 'AUTOKOM_RUNNER_SHARED_KEY')]) {
                    sh 'set +x; python3 /opt/autokom-runner/autokom_agent.py sast'
                }
            }
        }
        stage('SCA Trivy') {
            steps {
                withCredentials([string(credentialsId: 'autokom-runner-key', variable: 'AUTOKOM_RUNNER_SHARED_KEY')]) {
                    sh 'set +x; python3 /opt/autokom-runner/autokom_agent.py sca'
                }
            }
        }
        stage('Build isolé / Registry') {
            steps {
                withCredentials([string(credentialsId: 'autokom-runner-key', variable: 'AUTOKOM_RUNNER_SHARED_KEY')]) {
                    sh 'set +x; python3 /opt/autokom-runner/autokom_agent.py build'
                }
            }
        }
        stage('Kubernetes / Release') {
            steps {
                withCredentials([string(credentialsId: 'autokom-runner-key', variable: 'AUTOKOM_RUNNER_SHARED_KEY')]) {
                    sh 'set +x; python3 /opt/autokom-runner/autokom_agent.py deploy'
                }
            }
        }
        stage('Healthcheck / Readiness') {
            steps {
                withCredentials([string(credentialsId: 'autokom-runner-key', variable: 'AUTOKOM_RUNNER_SHARED_KEY')]) {
                    sh 'set +x; python3 /opt/autokom-runner/autokom_agent.py health'
                }
            }
        }
    }
    post {
        failure { echo 'AUTOKOM_LOG: Job échoué ; voir logs protégés de Jenkins.' }
        aborted { echo 'AUTOKOM_LOG: Job annulé.' }
    }
}
