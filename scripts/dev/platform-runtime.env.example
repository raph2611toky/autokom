# À copier exclusivement sur le serveur : /etc/autokom/platform-runtime.env
# chmod 600, root:root. Ne jamais ajouter ce fichier au dépôt Git.
AUTOKOM_JENKINS_URL=http://127.0.0.1:8080
AUTOKOM_JENKINS_JOB=autokom-client-deploy
AUTOKOM_JENKINS_USER=SERVICE_USER_TO_CONFIGURE
AUTOKOM_JENKINS_API_TOKEN=REPLACE_WITH_SERVER_SECRET
AUTOKOM_INGRESS_IPV4=REPLACE_WITH_STATIC_AWS_PUBLIC_IP
AUTOKOM_MANAGED_DOMAIN_SUFFIX=apps.auto.ik0m.tech
AUTOKOM_CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID
AUTOKOM_CLOUDFLARE_TOKEN=REPLACE_WITH_SCOPED_DNS_TOKEN
AUTOKOM_ACME_EMAIL=noreply@ik0m.tech
