[Unit]
Description=AUTOKOM GCP delivery and verified per-application HTTPS cutover
After=network-online.target autokom-ha-autopublish.service
Wants=network-online.target
[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/autokom/source/scripts/ha
ExecStart=/usr/bin/python3 /opt/autokom/source/scripts/ha/autokom_ha_delivery.py --public-dns
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/autokom/ha /var/lib/autokom/client-runtime /run/lock
TimeoutStartSec=600
[Install]
WantedBy=multi-user.target
