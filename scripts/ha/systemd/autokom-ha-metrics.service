[Unit]
Description=AUTOKOM GCP HA - Prometheus private metrics exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
Environment=AUTOKOM_GCP_AUTH_MODE=metadata
ExecStart=/usr/bin/python3 /opt/autokom/source/scripts/ha/autokom_ha_metrics_server.py --port 19191
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
