      "id": 1,
      "type": "timeseries",
      "title": "Instances MIG",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "autokom_ha_mig_instances",
          "refId": "A",
